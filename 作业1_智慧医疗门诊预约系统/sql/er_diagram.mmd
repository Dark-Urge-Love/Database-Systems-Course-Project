erDiagram
    department {
        INT dept_id PK "科室ID"
        VARCHAR(50) dept_name UK "科室名称"
        VARCHAR(20) dept_type "科室类型：内科/外科/专科"
        VARCHAR(50) location "科室位置"
        VARCHAR(20) phone "科室电话"
        TINYINT status "状态：1启用 0停用"
    }
    patient {
        INT patient_id PK "患者ID"
        VARCHAR(50) patient_name "姓名"
        CHAR(1) gender "性别：男/女"
        DATE birth_date "出生日期"
        VARCHAR(20) phone UK "手机号"
        VARCHAR(18) id_card UK "身份证号"
        VARCHAR(20) medical_card_no "就诊卡号"
        DATETIME create_time "建档时间"
        TINYINT status "状态：1正常 0注销"
    }
    doctor {
        INT doctor_id PK "医生ID"
        VARCHAR(50) doctor_name "姓名"
        CHAR(1) gender "性别：男/女"
        VARCHAR(20) title "职称：主任医师/副主任医师/主治医师/住院医师"
        INT dept_id FK "所属科室ID"
        VARCHAR(20) phone "联系电话"
        DATE hire_date "入职日期"
        VARCHAR(200) intro "擅长简介"
        TINYINT status "状态：1在职 0离职"
    }
    schedule {
        INT schedule_id PK "排班ID"
        INT doctor_id FK,UK "医生ID"
        DATE work_date UK "出诊日期"
        VARCHAR(10) period UK "时段：上午/下午"
        INT total_slots "总号源数"
        INT remain_slots "剩余号源数"
        DECIMAL reg_fee "挂号费(元)"
        VARCHAR(20) room "诊室"
    }
    appointment {
        INT appt_id PK "预约ID"
        INT patient_id FK "患者ID"
        INT schedule_id FK "排班ID"
        DATETIME appt_time "预约时间"
        INT queue_no "就诊顺序号"
        VARCHAR(10) status "状态：已预约/已就诊/已取消/爽约"
    }
    visit {
        INT visit_id PK "就诊ID"
        INT appt_id FK,UK "预约ID(唯一,1-1)"
        INT patient_id FK "患者ID"
        INT doctor_id FK "医生ID"
        DATETIME visit_time "就诊时间"
        VARCHAR(500) chief_complaint "主诉"
        VARCHAR(500) diagnosis "诊断"
        VARCHAR(500) advice "医嘱"
    }
    prescription {
        INT presc_id PK "处方ID"
        INT visit_id FK "就诊ID"
        DATETIME presc_time "开方时间"
        VARCHAR(10) presc_type "处方类型：西药/中药"
        VARCHAR(10) status "状态：已开方/已缴费/已作废"
    }
    drug {
        INT drug_id PK "药品ID"
        VARCHAR(100) drug_name "药品名称"
        VARCHAR(50) spec "规格"
        VARCHAR(10) unit "单位"
        VARCHAR(100) manufacturer "生产厂家"
        DECIMAL price "当前单价(元)"
        INT stock "库存量"
        TINYINT is_rx "是否处方药：1是 0否"
        TINYINT status "状态：1在用 0停用"
    }
    prescription_item {
        INT item_id PK "明细ID"
        INT presc_id FK "处方ID"
        INT drug_id FK "药品ID"
        INT quantity "数量"
        VARCHAR(100) usage_note "用法用量"
        DECIMAL unit_price "开方时单价(元)"
    }
    payment {
        INT pay_id PK "缴费ID"
        INT visit_id FK "就诊ID"
        VARCHAR(10) fee_type "费用类型：挂号费/药费"
        DECIMAL amount "金额(元)"
        VARCHAR(10) pay_method "支付方式：现金/微信/支付宝/医保"
        DATETIME pay_time "支付时间"
        VARCHAR(10) status "状态：已支付/已退款"
    }
    department ||--o{ doctor : "隶属科室"
    doctor ||--o{ schedule : "排班"
    patient ||--o{ appointment : "发起预约"
    schedule ||--o{ appointment : "号源归属"
    appointment ||--|| visit : "接诊（visit.appt_id 唯一）"
    visit ||--o{ prescription : "开出处方"
    prescription ||--o{ prescription_item : "处方含药品"
    drug ||--o{ prescription_item : "处方含药品"
    visit ||--o{ payment : "产生缴费"
    patient ||--o{ visit : "就诊"
    doctor ||--o{ visit : "接诊医生"