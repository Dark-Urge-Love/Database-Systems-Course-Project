# 默认：自动识别文本文件，仓库内统一存 LF
* text=auto eol=lf

# ---------- 必须在 Linux/Unix 下执行，强制 LF ----------
*.sh    text eol=lf
*.py    text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# ---------- Windows 专用，强制 CRLF ----------
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# ---------- 二进制，不做换行符转换 ----------
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
