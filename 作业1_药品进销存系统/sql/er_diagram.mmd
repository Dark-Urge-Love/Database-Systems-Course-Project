erDiagram
    drug_category {
        INT category_id PK "分类ID"
        VARCHAR(50) category_name UK "分类名称"
        VARCHAR(20) category_code UK "分类编码"
        VARCHAR(200) description "分类说明"
        TINYINT status "状态：1启用 0停用"
    }
    supplier {
        INT supplier_id PK "供应商ID"
        VARCHAR(100) supplier_name UK "供应商名称"
        VARCHAR(50) contact_person "联系人"
        VARCHAR(20) phone "联系电话"
        VARCHAR(200) address "联系地址"
        VARCHAR(50) license_no UK "药品经营许可证号"
        VARCHAR(10) credit_level "信用等级：A/B/C"
        DATE cooperate_date "合作起始日期"
        TINYINT status "状态：1合作中 0已停用"
    }
    warehouse {
        INT warehouse_id PK "仓库ID"
        VARCHAR(50) warehouse_name UK "仓库名称"
        VARCHAR(100) location "仓库地址"
        INT capacity "库容(件)"
        VARCHAR(50) manager "仓库负责人"
        TINYINT status "状态：1启用 0停用"
    }
    employee {
        INT employee_id PK "员工ID"
        VARCHAR(20) emp_no UK "工号"
        VARCHAR(50) emp_name "姓名"
        CHAR(1) gender "性别：男/女"
        VARCHAR(20) position "岗位：采购员/仓管员/销售员/质检员"
        INT warehouse_id FK "所属仓库ID"
        VARCHAR(20) phone "联系电话"
        DATE hire_date "入职日期"
        TINYINT status "状态：1在职 0离职"
    }
    drug {
        INT drug_id PK "药品ID"
        VARCHAR(20) drug_code UK "药品编码"
        VARCHAR(100) drug_name UK "药品名称"
        INT category_id FK "分类ID"
        VARCHAR(50) spec UK "规格"
        VARCHAR(10) unit "单位"
        VARCHAR(100) manufacturer "生产厂家"
        VARCHAR(50) approval_no "批准文号"
        DECIMAL purchase_price "采购价(元)"
        DECIMAL retail_price "零售价(元)"
        TINYINT is_rx "是否处方药：1是 0否"
        INT shelf_life_months "保质期(月)"
        TINYINT status "状态：1在售 0停用"
    }
    purchase_order {
        INT po_id PK "采购单ID"
        VARCHAR(24) po_no UK "采购单号"
        INT supplier_id FK "供应商ID"
        INT warehouse_id FK "入库仓库ID"
        INT employee_id FK "采购员ID"
        DATE order_date "下单日期"
        DATE expect_date "预计到货日期"
        DECIMAL total_amount "采购金额(元)"
        VARCHAR(10) status "状态：待入库/已入库/已取消"
    }
    purchase_item {
        INT item_id PK "明细ID"
        INT po_id FK "采购单ID"
        INT drug_id FK "药品ID"
        INT quantity "采购数量"
        DECIMAL unit_price "采购单价(元)"
        DECIMAL amount "采购金额(元)"
        VARCHAR(30) batch_no "批号"
        DATE production_date "生产日期"
        DATE expiry_date "有效期至"
    }
    stock {
        INT stock_id PK "库存ID"
        INT drug_id FK,UK "药品ID"
        INT warehouse_id FK,UK "仓库ID"
        INT quantity "库存数量"
        INT safety_stock "安全库存"
        DATETIME update_time "最后更新时间"
    }
    stock_batch {
        INT batch_id PK "批次ID"
        INT purchase_item_id FK,UK "采购明细ID(1-1)"
        INT drug_id FK,UK "药品ID"
        INT warehouse_id FK,UK "仓库ID"
        VARCHAR(30) batch_no UK "批号"
        DATE production_date "生产日期"
        DATE expiry_date "有效期至"
        INT quantity "批次结存数量"
        DECIMAL purchase_price "批次采购价(元)"
        DATE in_date "入库日期"
    }
    sale_order {
        INT so_id PK "销售单ID"
        VARCHAR(24) so_no UK "销售单号"
        VARCHAR(100) customer_name "客户名称"
        VARCHAR(20) customer_type "客户类型：连锁药店/医院/诊所/个人"
        INT warehouse_id FK "出库仓库ID"
        INT employee_id FK "销售员ID"
        DATE sale_date "销售日期"
        DECIMAL total_amount "销售金额(元)"
        VARCHAR(10) status "状态：已出库/已退货"
    }
    sale_item {
        INT item_id PK "明细ID"
        INT so_id FK "销售单ID"
        INT drug_id FK "药品ID"
        INT quantity "销售数量"
        DECIMAL unit_price "销售单价(元)"
        DECIMAL amount "销售金额(元)"
    }
    stock_movement {
        BIGINT move_id PK "流水ID"
        INT drug_id FK "药品ID"
        INT warehouse_id FK "仓库ID"
        VARCHAR(20) move_type "变动类型：采购入库/销售出库/盘点调整/退货入库"
        VARCHAR(24) ref_no "关联单号"
        INT change_qty "变动数量(正入负出)"
        INT before_qty "变动前库存"
        INT after_qty "变动后库存"
        VARCHAR(30) batch_no "批号"
        INT employee_id FK "经办人ID"
        DATETIME move_time "发生时间"
    }
    access_log {
        BIGINT log_id PK "日志ID"
        VARCHAR(20) scene "场景：sale_out 销售出库"
        INT client_no "客户端序号"
        INT drug_id "药品ID(弱关联，不设外键)"
        INT qty "本次出库数量"
        TINYINT ok "结果：1成功 0库存不足"
        DECIMAL elapsed_ms "本次访问耗时(ms)"
        DATETIME created_at "访问时间"
    }
    drug_category ||--o{ drug : "分类包含药品"
    supplier ||--o{ purchase_order : "供应"
    warehouse ||--o{ employee : "归属"
    warehouse ||--o{ purchase_order : "入库到"
    employee ||--o{ purchase_order : "采购经办"
    purchase_order ||--o{ purchase_item : "包含明细"
    drug ||--o{ purchase_item : "被采购"
    purchase_item ||--|| stock_batch : "入库生成批次"
    drug ||--o{ stock : "库存"
    warehouse ||--o{ stock : "存放"
    drug ||--o{ stock_batch : "批次"
    warehouse ||--o{ stock_batch : "存放批次"
    warehouse ||--o{ sale_order : "出库自"
    employee ||--o{ sale_order : "销售经办"
    sale_order ||--o{ sale_item : "包含明细"
    drug ||--o{ sale_item : "被销售"
    drug ||--o{ stock_movement : "库存变动"
    warehouse ||--o{ stock_movement : "变动仓库"
    employee ||--o{ stock_movement : "经办"
    purchase_order ||--o{ purchase_item : "采购单-药品"
    drug ||--o{ purchase_item : "采购单-药品"
    sale_order ||--o{ sale_item : "销售单-药品"
    drug ||--o{ sale_item : "销售单-药品"